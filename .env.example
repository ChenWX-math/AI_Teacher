# DeepSeek（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
AGENT_RECURSION_LIMIT=8
AGENT_CONTEXT_MAX_TOKENS=12000
AGENT_CONTEXT_RECENT_MESSAGES=8
AGENT_SUMMARY_MAX_CHARS=2000
AGENT_CHARS_PER_TOKEN=1.5

# 本地可观测性（JSONL 日志默认不保存学生原文）
APP_LOG_PATH=logs/events.jsonl
APP_LOG_MAX_BYTES=5242880
APP_LOG_BACKUP_COUNT=3
APP_LOG_USER_CONTENT=false

# 可选：LangSmith Trace；不配置时不影响本地运行
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-teacher

# 可选：真实 Agent 评测的每百万 Token 单价；留 0 时只统计 Token，不显示金额
EVAL_INPUT_COST_PER_MILLION=0
EVAL_OUTPUT_COST_PER_MILLION=0

# DashScope Embedding（启用教材知识库时必填）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
RAG_SCORE_THRESHOLD=0.0

# Milvus Lite：建议在 Windows 上使用纯英文绝对路径
MILVUS_DB_PATH=D:\AI_Teacher_Milvus\ai_teacher_knowledge.db
MILVUS_COLLECTION=ai_teacher_knowledge

# 应用与持久化模式。JSON 模式不需要 PostgreSQL。
STORAGE_BACKEND=json
APP_BACKEND=local
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# PostgreSQL（Docker 本地开发示例；请在实际 .env 中更换密码）
POSTGRES_USER=ai_teacher
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_DB=ai_teacher
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_teacher:change_me_for_local_development@localhost:5432/ai_teacher

# 如果使用远程 Milvus，请配置 URI；配置后不再要求 MILVUS_DB_PATH
# MILVUS_URI=https://your-milvus-endpoint
# MILVUS_TOKEN=your_milvus_token
